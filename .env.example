# =============================================================================
# Cohort AI — Environment Variables
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Never commit .env.local or real secret keys.
# =============================================================================

# [Required | Server-only]
# Google Gemini API key used exclusively inside Next.js server routes (lib/gemini.ts).
# Do NOT prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# [Optional | Server-only]
# Gemini model ID used by lib/gemini.ts (defaults to gemini-4-hydrogen).
# When deploying externally (e.g., Vercel) with a standard Google AI Studio key,
# set this to a public model such as gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# [Optional | Reference]
# Firebase Web App API key. By default, client and server Firebase configuration
# (projectId, appId, apiKey, authDomain, firestoreDatabaseId) is loaded from
# firebase-applet-config.json in the project root.
FIREBASE_API_KEY=
