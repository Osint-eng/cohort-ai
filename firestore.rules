rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() == 8 && code.matches('^[A-Z0-9]{8}$');
    }

    function isValidTaskId(id) {
      return id is string && id.size() >= 2 && id.size() <= 32 && id.matches('^t[0-9]+$');
    }

    function isRoomOwner(roomCode) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomCode))
        && get(/databases/$(database)/documents/rooms/$(roomCode)).data.ownerId == request.auth.uid;
    }

    function isFullMember(roomCode) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomCode)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/rooms/$(roomCode)/members/$(request.auth.uid)).data.role in ['owner', 'member'];
    }

    function isFullMemberAfter(roomCode) {
      return isSignedIn()
        && existsAfter(/databases/$(database)/documents/rooms/$(roomCode)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/rooms/$(roomCode)/members/$(request.auth.uid)).data.role in ['owner', 'member'];
    }

    function isValidRoom(data, roomCode) {
      return data.keys().hasAll(['code', 'title', 'summary', 'ownerId', 'nextTaskNumber', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'code', 'title', 'summary', 'ownerId', 'nextTaskNumber', 'createdAt', 'updatedAt',
          'agentAggressiveness', 'agentStatus', 'agentStatusAt', 'lastProactiveAt'
        ])
        && data.code is string && data.code == roomCode
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.summary is string && data.summary.size() <= 600
        && isValidId(data.ownerId)
        && data.nextTaskNumber is int && data.nextTaskNumber >= 1 && data.nextTaskNumber <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('agentAggressiveness' in data) || data.agentAggressiveness in ['low', 'medium', 'high'])
        && (!('agentStatus' in data) || data.agentStatus in ['watching', 'thinking'])
        && (!('agentStatusAt' in data) || data.agentStatusAt is timestamp)
        && (!('lastProactiveAt' in data) || data.lastProactiveAt is timestamp);
    }

    function isValidMember(data, memberId) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'role', 'status', 'online', 'joinedAt', 'lastSeenAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'status', 'online', 'joinedAt', 'lastSeenAt'])
        && data.uid is string && data.uid == memberId
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && (
          (data.role == 'owner' && data.status == 'active')
          || (data.role == 'member' && data.status == 'active')
          || (data.role == 'pending' && data.status == 'pending')
        )
        && data.online is bool
        && data.joinedAt is timestamp
        && data.lastSeenAt is timestamp;
    }

    function isValidInvite(data, inviteId) {
      return data.keys().hasAll(['id', 'createdBy', 'createdAt', 'expiresAt', 'maxUses', 'usedCount', 'active'])
        && data.keys().hasOnly(['id', 'createdBy', 'createdAt', 'expiresAt', 'maxUses', 'usedCount', 'active'])
        && data.id is string && data.id == inviteId && isValidId(data.id)
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && data.maxUses is int && data.maxUses >= 1 && data.maxUses <= 1000
        && data.usedCount is int && data.usedCount >= 0 && data.usedCount <= data.maxUses
        && data.active is bool;
    }

    function isValidMessage(data, messageId) {
      return data.keys().hasAll(['id', 'senderId', 'triggeredBy', 'senderName', 'role', 'text', 'createdAt'])
        && data.keys().hasOnly(['id', 'senderId', 'triggeredBy', 'senderName', 'role', 'text', 'createdAt'])
        && data.id is string && data.id == messageId
        && data.triggeredBy is string && data.triggeredBy == request.auth.uid
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.role in ['user', 'assistant']
        && ((data.role == 'user' && data.senderId == request.auth.uid) || (data.role == 'assistant' && data.senderId == 'cohort'))
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 8000
        && data.createdAt is timestamp;
    }

    function isValidTask(data, taskId) {
      return data.keys().hasAll(['id', 'title', 'suggested_owner', 'owner_uid', 'due_date', 'status', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'description', 'task_type', 'suggested_owner', 'owner_uid', 'due_date', 'status', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == taskId && isValidTaskId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('task_type' in data) || data.task_type in ['frontend', 'backend', 'design', 'research', 'general'])
        && data.suggested_owner is string && data.suggested_owner.size() >= 1 && data.suggested_owner.size() <= 80
        && data.owner_uid is string && data.owner_uid.size() <= 128
        && data.due_date is string && data.due_date.size() >= 1 && data.due_date.size() <= 40
        && data.status in ['todo', 'in_progress', 'blocked', 'done']
        && data.updatedBy is string && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLogEntry(data, logId) {
      return data.keys().hasAll(['id', 'actorId', 'triggeredBy', 'actor', 'action', 'task_id', 'note', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorId', 'triggeredBy', 'actor', 'action', 'task_id', 'note', 'createdAt'])
        && data.id is string && data.id == logId
        && data.triggeredBy is string && data.triggeredBy == request.auth.uid
        && (data.actorId == request.auth.uid || data.actorId == 'cohort')
        && data.actor is string && data.actor.size() >= 1 && data.actor.size() <= 80
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 60
        && data.task_id is string && data.task_id.size() >= 1 && data.task_id.size() <= 40
        && data.note is string && data.note.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidRateLimit(data, userId) {
      return data.keys().hasAll(['uid', 'roomWindowStart', 'roomCount', 'cohortWindowStart', 'cohortCount', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'roomWindowStart', 'roomCount', 'cohortWindowStart', 'cohortCount', 'updatedAt'])
        && isValidId(data.uid) && data.uid == userId && data.uid == request.auth.uid
        && data.roomWindowStart is timestamp
        && data.roomCount is int && data.roomCount >= 0 && data.roomCount <= 10
        && data.cohortWindowStart is timestamp
        && data.cohortCount is int && data.cohortCount >= 0 && data.cohortCount <= 20
        && data.updatedAt is timestamp;
    }

    match /rooms/{roomCode} {
      allow get: if isSignedIn() && isValidRoomCode(roomCode);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidRoomCode(roomCode)
        && isValidRoom(incoming(), roomCode)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('agentStatusAt' in incoming()) || incoming().agentStatusAt == request.time)
        && (!('lastProactiveAt' in incoming()) || incoming().lastProactiveAt == request.time);
      allow update: if isSignedIn()
        && isValidRoomCode(roomCode)
        && isValidRoom(incoming(), roomCode)
        && isFullMember(roomCode)
        && incoming().ownerId == existing().ownerId
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['summary', 'nextTaskNumber', 'agentStatus', 'agentStatusAt', 'lastProactiveAt', 'updatedAt'])
            && (!('agentStatusAt' in incoming().diff(existing()).affectedKeys()) || incoming().agentStatusAt == request.time)
            && (!('lastProactiveAt' in incoming().diff(existing()).affectedKeys()) || incoming().lastProactiveAt == request.time)
          )
          || (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'agentAggressiveness', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /members/{memberId} {
        allow get: if isValidRoomCode(roomCode)
          && isValidId(memberId)
          && (isFullMember(roomCode) || isRoomOwner(roomCode) || (isSignedIn() && memberId == request.auth.uid));
        allow list: if isValidRoomCode(roomCode) && (isFullMember(roomCode) || isRoomOwner(roomCode));
        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(memberId)
          && memberId == request.auth.uid
          && isValidMember(incoming(), memberId)
          && incoming().uid == request.auth.uid
          && incoming().joinedAt == request.time
          && incoming().lastSeenAt == request.time
          && existsAfter(/databases/$(database)/documents/rooms/$(roomCode))
          && (
            (incoming().role == 'owner' && incoming().status == 'active' && getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data.ownerId == request.auth.uid)
            || (incoming().role == 'pending' && incoming().status == 'pending' && exists(/databases/$(database)/documents/rooms/$(roomCode)))
          );
        allow update: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(memberId)
          && isValidMember(incoming(), memberId)
          && incoming().uid == existing().uid
          && incoming().joinedAt == existing().joinedAt
          && incoming().lastSeenAt == request.time
          && (
            // Self-update presence & profile (cannot escalate role)
            (
              memberId == request.auth.uid
              && incoming().role == existing().role
              && incoming().status == (existing().role == 'pending' ? 'pending' : 'active')
              && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'status', 'online', 'lastSeenAt'])
            )
            // Owner-only approval from pending -> member
            || (
              isRoomOwner(roomCode)
              && existing().role == 'pending'
              && incoming().role == 'member'
              && incoming().status == 'active'
              && incoming().displayName == existing().displayName
              && incoming().photoURL == existing().photoURL
              && incoming().online == existing().online
              && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'lastSeenAt'])
            )
          );
        allow delete: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(memberId)
          && (memberId == request.auth.uid || (isRoomOwner(roomCode) && memberId != request.auth.uid));
      }

      match /invites/{inviteId} {
        allow get: if isSignedIn() && isValidRoomCode(roomCode) && isValidId(inviteId);
        allow list: if isValidRoomCode(roomCode) && isRoomOwner(roomCode);
        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(inviteId)
          && isValidInvite(incoming(), inviteId)
          && isRoomOwner(roomCode)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().expiresAt > request.time
          && incoming().usedCount == 0
          && incoming().active == true;
        allow update: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(inviteId)
          && isValidInvite(incoming(), inviteId)
          && incoming().id == existing().id
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && (
            // Owner-only revoke or edit limits
            (
              isRoomOwner(roomCode)
              && incoming().usedCount == existing().usedCount
              && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'expiresAt', 'maxUses'])
            )
            // Signed-in user redeeming a valid invite while joining the room
            || (
              existing().active == true
              && request.time < existing().expiresAt
              && existing().usedCount < existing().maxUses
              && incoming().active == existing().active
              && incoming().expiresAt == existing().expiresAt
              && incoming().maxUses == existing().maxUses
              && incoming().usedCount == existing().usedCount + 1
              && incoming().diff(existing()).affectedKeys().hasOnly(['usedCount'])
              && existsAfter(/databases/$(database)/documents/rooms/$(roomCode)/members/$(request.auth.uid))
            )
          );
        allow delete: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(inviteId)
          && isRoomOwner(roomCode);
      }

      match /messages/{messageId} {
        allow get: if isValidRoomCode(roomCode) && isValidId(messageId) && isFullMember(roomCode);
        allow list: if isValidRoomCode(roomCode) && isFullMember(roomCode);
        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(messageId)
          && isValidMessage(incoming(), messageId)
          && incoming().createdAt == request.time
          && (isFullMember(roomCode) || isFullMemberAfter(roomCode));
        allow update, delete: if false;
      }

      match /tasks/{taskId} {
        allow get: if isValidRoomCode(roomCode) && isValidTaskId(taskId) && isFullMember(roomCode);
        allow list: if isValidRoomCode(roomCode) && isFullMember(roomCode);
        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidTaskId(taskId)
          && isValidTask(incoming(), taskId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isFullMember(roomCode);
        allow update: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidTaskId(taskId)
          && isValidTask(incoming(), taskId)
          && isFullMember(roomCode)
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'task_type', 'suggested_owner', 'owner_uid', 'due_date', 'status', 'updatedBy', 'updatedAt']);
        allow delete: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidTaskId(taskId)
          && isFullMember(roomCode);
      }

      match /logs/{logId} {
        allow get: if isValidRoomCode(roomCode) && isValidId(logId) && isFullMember(roomCode);
        allow list: if isValidRoomCode(roomCode) && isFullMember(roomCode);
        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(logId)
          && isValidLogEntry(incoming(), logId)
          && incoming().createdAt == request.time
          && (isFullMember(roomCode) || isFullMemberAfter(roomCode));
        allow update, delete: if false;
      }
    }

    match /rateLimits/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidRateLimit(incoming(), userId)
        && incoming().roomWindowStart == request.time
        && incoming().cohortWindowStart == request.time
        && incoming().updatedAt == request.time
        && incoming().roomCount <= 1
        && incoming().cohortCount <= 1
        && (incoming().roomCount + incoming().cohortCount) == 1;
      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidRateLimit(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['cohortCount', 'cohortWindowStart', 'updatedAt'])
            && (
              (incoming().cohortWindowStart == existing().cohortWindowStart && incoming().cohortCount == existing().cohortCount + 1 && incoming().cohortCount <= 20)
              || (request.time >= existing().cohortWindowStart + duration.value(590, 's') && incoming().cohortWindowStart == request.time && incoming().cohortCount == 1)
            )
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['roomCount', 'roomWindowStart', 'updatedAt'])
            && (
              (incoming().roomWindowStart == existing().roomWindowStart && incoming().roomCount == existing().roomCount + 1 && incoming().roomCount <= 10)
              || (request.time >= existing().roomWindowStart + duration.value(590, 's') && incoming().roomWindowStart == request.time && incoming().roomCount == 1)
            )
          )
        );
      allow delete: if false;
    }
  }
}
